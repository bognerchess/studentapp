  "@importErrorTooManyGames": {
    "description": "Error: more games than the limit.",
    "placeholders": {
      "max": {
        "type": "int",
        "example": "500"
      }
    }
  },
  "importErrorNoGames": "No chess game was found in this text. A game looks like this: 1. e4 e5 2. Nf3 Nc6",
  "@importErrorNoGames": {
    "description": "Error: the text contains neither tags nor moves."
  },
  "importErrorNoMoves": "This game has no moves.",
  "@importErrorNoMoves": {
    "description": "Error: a game with tags but without moves."
  },
  "importErrorCustomStart": "This game starts from a set-up position (FEN). For now, only games that start from the normal starting position can be imported.",
  "@importErrorCustomStart": {
    "description": "Error: the PGN has a FEN or SetUp tag."
  },
  "importErrorVariant": "This is a game of {variant}. Only standard chess can be imported.",
  "@importErrorVariant": {
    "description": "Error: the PGN has a Variant tag other than standard chess.",
    "placeholders": {
      "variant": {
        "type": "String",
        "example": "Chess960"
      }
    }
  },
  "importErrorIllegalMove": "{move} is not a legal move in this position.",
  "@importErrorIllegalMove": {
    "description": "Error: a move of the main line is illegal. The placeholder is the numbered move as written.",
    "placeholders": {
      "move": {
        "type": "String",
        "example": "13. Rh5"
      }
    }
  },
  "importErrorAmbiguousMove": "{move} is ambiguous: more than one piece can make this move. Add the file or rank it starts from, as in Nbd7.",
  "@importErrorAmbiguousMove": {
    "description": "Error: a SAN move fits several legal moves.",
    "placeholders": {
      "move": {
        "type": "String",
        "example": "10... Nd7"
      }
    }
  },
  "importErrorUnreadable": "“{token}” is not a chess move.",
  "@importErrorUnreadable": {
    "description": "Error: a word in the movetext is not a move. Moves use English piece letters (K, Q, R, B, N).",
    "placeholders": {
      "token": {
        "type": "String",
        "example": "Nf9"
      }
    }
  },
  "importErrorUnreadableHint": "Moves need the English piece letters K, Q, R, B and N.",
  "@importErrorUnreadableHint": {
    "description": "Second sentence of the unreadable-move error."
  },
  "importErrorUnterminatedComment": "A comment that opens with a curly bracket is never closed.",
  "@importErrorUnterminatedComment": {
    "description": "Error: unterminated brace comment."
  },
  "importErrorUnterminatedVariation": "A variation that opens with a round bracket is never closed.",
  "@importErrorUnterminatedVariation": {
    "description": "Error: unterminated variation."
  },
  "importErrorWhereLine": "Line {line}",
  "@importErrorWhereLine": {
    "description": "Where in the text the error is.",
    "placeholders": {
      "line": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "importErrorWhereLineMove": "Line {line}, at move {number}",
  "@importErrorWhereLineMove": {
    "description": "Where in the text the error is, with the move number.",
    "placeholders": {
      "line": {
        "type": "int",
        "example": "12"
      },
      "number": {
        "type": "int",
        "example": "13"
      }
    }
  },
