    "description": "Status line under the board while the game goes on.",
    "placeholders": {
      "number": {
        "type": "int",
        "example": "12"
      },
      "side": {
        "type": "String",
        "example": "white"
      }
    }
  },
  "entryStatusCheckmate": "Checkmate · {winner, select, white{White wins} other{Black wins}}",
  "@entryStatusCheckmate": {
    "description": "Status line under the board when the position shown is checkmate.",
    "placeholders": {
      "winner": {
        "type": "String",
        "example": "white"
      }
    }
  },
  "entryStatusStalemate": "Stalemate · draw",
  "@entryStatusStalemate": {
    "description": "Status line under the board when the position shown is stalemate."
  },
  "entryStatusInsufficientMaterial": "Draw · insufficient material",
  "@entryStatusInsufficientMaterial": {
    "description": "Status line under the board when neither side can checkmate any more."
  },
  "entryOverwriteTitle": "{count, plural, =1{Replace the following move?} other{Replace the following {count} moves?}}",
  "@entryOverwriteTitle": {
    "description": "Title of the confirmation shown when a different move is played in the middle of the entered game.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "entryOverwriteMessage": "{newSan} is not the move you entered here before ({oldSan}). Everything from {oldSan} on will be removed.",
  "@entryOverwriteMessage": {
    "description": "Body of the overwrite confirmation.",
    "placeholders": {
      "newSan": {
        "type": "String",
        "example": "Nf6"
      },
      "oldSan": {
        "type": "String",
        "example": "Nc6"
      }
    }
  },
  "entryOverwriteConfirm": "Replace",
  "@entryOverwriteConfirm": {
    "description": "Confirms the overwrite: the new move replaces the rest of the game."
  },
  "entryOverwriteCancel": "Keep moves",
  "@entryOverwriteCancel": {
    "description": "Dismisses the overwrite confirmation; nothing changes."
  },
  "entrySavedAsDraft": "Saved as draft",
  "@entrySavedAsDraft": {
    "description": "Confirmation after tapping Done while the next step of the flow is not available."
  },
