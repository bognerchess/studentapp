      "number": {
        "type": "int",
        "example": "12"
      },
      "side": {
        "type": "String",
        "example": "white"
      },
      "san": {
        "type": "String",
        "example": "Nf3"
      }
    }
  },
  "entryStatusToMove": "Move {number} · {side, select, white{White to move} other{Black to move}}",
