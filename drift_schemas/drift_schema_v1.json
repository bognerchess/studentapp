  "fixed_sql": [
    {
      "name": "drafts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drafts\" (\"id\" TEXT NOT NULL, \"owner_sub\" TEXT NOT NULL, \"pgn\" TEXT NOT NULL, \"meta_json\" TEXT NOT NULL DEFAULT '{}', \"state\" TEXT NOT NULL, \"client_game_id\" TEXT NOT NULL UNIQUE, \"wants_analysis\" INTEGER NOT NULL DEFAULT 1 CHECK (\"wants_analysis\" IN (0, 1)), \"server_game_id\" TEXT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT NULL, \"next_attempt_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cached_games",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_games\" (\"game_id\" TEXT NOT NULL, \"owner_sub\" TEXT NOT NULL, \"summary_json\" TEXT NOT NULL, \"played_date\" TEXT NULL, \"opponent_name\" TEXT NULL, \"opponent_search\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, \"fetched_at\" INTEGER NOT NULL, PRIMARY KEY (\"game_id\"));"
        }
      ]
    },
    {
      "name": "cached_analyses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_analyses\" (\"game_id\" TEXT NOT NULL, \"owner_sub\" TEXT NOT NULL, \"schema_version\" INTEGER NOT NULL, \"schema_minor\" INTEGER NOT NULL, \"payload\" TEXT NOT NULL, \"fetched_at\" INTEGER NOT NULL, PRIMARY KEY (\"game_id\"));"
        }
      ]
    },
    {
      "name": "pending_jobs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pending_jobs\" (\"job_id\" TEXT NOT NULL, \"game_id\" TEXT NOT NULL, \"owner_sub\" TEXT NOT NULL, \"state\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"last_polled_at\" INTEGER NULL, PRIMARY KEY (\"job_id\"));"
        }
      ]
    },
    {
      "name": "event_outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"event_outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"owner_sub\" TEXT NULL, \"device_id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"props_json\" TEXT NOT NULL DEFAULT '{}', \"attempts\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "feedback_outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feedback_outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"owner_sub\" TEXT NOT NULL, \"comment_id\" TEXT NOT NULL, \"rating\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, UNIQUE (\"owner_sub\", \"comment_id\"));"
        }
