//
// Base configuration of the ShareExtension target for Debug. The same chain
// as the Runner target gets through ios/Flutter/Debug.xcconfig:
// Generated.xcconfig first (without FLUTTER_BUILD_NAME and FLUTTER_BUILD_NUMBER
// the extension's version strings would be empty), then the shared settings,
// then what differs.

#include "../Flutter/Generated.xcconfig"
#include "Debug.xcconfig"
#include "ShareExtension.xcconfig"

// The Runner target has these two in project.pbxproj, from the Flutter template.
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
